bin/
dist/
*.test
*.out
.env
.env.local
hexsign

# Xcode projects generated locally by examples/ci-test/run-local.sh
examples/ci-test/*/*.xcodeproj/

# `output` is a common name in some users' global gitignores; make sure
# our internal/output package is never silently swallowed.
!internal/output/
!internal/output/**

# macOS
.DS_Store

# Editor / tooling
.claude/

# Apple signing material — never commit certificates or their passphrases
*.p12
*.password
*.cer
*.mobileprovision
*.pem
*.key
